# Velocity Development Environment
# Copy to .env and fill in values

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=velocity_dev
DB_USER=velocity
DB_PASSWORD=change_me_in_production

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Search Index ────────────────────────────────────────────
VELOCITY_INDEX_PATH=~/Library/Application Support/Velocity/search_index.db
VELOCITY_INDEX_BATCH_SIZE=500
VELOCITY_INDEX_THROTTLE_MS=50

# ── Cloud Providers (optional) ──────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
AWS_S3_BUCKET=

GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=

# ── Application ─────────────────────────────────────────────
VELOCITY_ENV=development
VELOCITY_LOG_LEVEL=debug
VELOCITY_CACHE_DIR=~/Library/Caches/Velocity
VELOCITY_MAX_CONCURRENT_OPS=4
VELOCITY_THUMBNAIL_QUALITY=80

# ── Telemetry (opt-in) ─────────────────────────────────────
VELOCITY_TELEMETRY_ENABLED=false
VELOCITY_TELEMETRY_ENDPOINT=
